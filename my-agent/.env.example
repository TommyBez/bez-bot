# Signs session cookies and derives the vault key. Required in production (32+ random characters).
BEZBOT_SECRET=

# Durable storage (Vercel Marketplace: Upstash Redis and Vercel Blob). Local files under .data/ when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Model access through the Vercel AI Gateway. Locally, `/login` in `pnpm dev:eve` works instead.
# AI_GATEWAY_API_KEY=

# BEZBOT_SANDBOX=vercel      # or "default" to force the local sandbox (Docker gets a desktop too)
# BEZBOT_DESKTOP=0           # skip the desktop and computer_use
# BEZBOT_DEV_TICK=0          # turn off the development routine ticker
# BEZBOT_DATA_DIR=.data

# Where server code reaches /eve/v1 (auto-detected on Vercel, in dev, and for `pnpm start`).
# BEZBOT_EVE_ORIGIN=
# Lets server-side deliveries through Vercel Deployment Protection.
# VERCEL_AUTOMATION_BYPASS_SECRET=
